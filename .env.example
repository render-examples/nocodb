# Asked for on deploy:
NC_ADMIN_EMAIL=you@example.com

# Set by the Blueprint: DATABASE_URL, NC_PUBLIC_URL, NC_ADMIN_PASSWORD (generated),
# NC_CONNECTION_ENCRYPT_KEY (generated), NC_DISABLE_TELE, NC_DISABLE_MUX, PORT.
#
# Optional, add on the nocodb service after deploy:
# NC_SMTP_FROM=nocodb@example.com  # invite and password-reset emails
# NC_SMTP_HOST=
# NC_SMTP_PORT=587
# NC_SMTP_USERNAME=
# NC_SMTP_PASSWORD=
# NC_REDIS_URL=                    # shared cache; only needed for multiple instances
